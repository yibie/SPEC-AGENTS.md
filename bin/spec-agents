#!/bin/bash
set -e

# Spec-AGENTS CLI
# 自动定位仓库根目录（即脚本所在目录的上一级）
# 兼容 macOS/Linux 的 readlink 问题

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
REPO_ROOT="$( cd -P "$( dirname "$SOURCE" )/.." && pwd )"

# CLI Argument Parsing
COMMAND="$1"
TARGET_DIR="${2:-.}" # Default to current directory
LANG="${3:-cn}"      # Default to Chinese
USE_LINK=false       # Default to copy mode

# Parse optional flags (don't shift to preserve positional args)
for arg in "$@"; do
  case "$arg" in
    --link|-l)
      USE_LINK=true
      ;;
  esac
done

show_help() {
  echo "🤖 Spec-AGENTS CLI v3"
  echo ""
  echo "Usage:"
  echo "  spec-agents init [lang] [--link|-l]    Initialize in current directory"
  echo "  spec-agents install <path> [lang] [--link|-l] Install to specific directory"
  echo ""
  echo "Arguments:"
  echo "  lang: cn (default) | en"
  echo "  --link, -l: Use symbolic links instead of copying files"
  echo ""
  echo "Examples:"
  echo "  spec-agents init"
  echo "  spec-agents init en --link"
  echo "  spec-agents install ../my-new-project cn -l"
}

if [ -z "$COMMAND" ] || [ "$COMMAND" == "help" ] || [ "$COMMAND" == "--help" ] || [ "$COMMAND" == "-h" ]; then
  show_help
  exit 0
fi

# Normalize Target Directory
if [ "$COMMAND" == "init" ]; then
    TARGET_DIR="."
    # Check if $2 is a language or a flag
    if [[ "${2:-}" == --* ]] || [[ "${2:-}" == -* ]]; then
      LANG="cn"
    else
      LANG="${2:-cn}"
    fi
    # Check for --link flag in remaining args
    for arg in "${@:2}"; do
      if [[ "$arg" == "--link" ]] || [[ "$arg" == "-l" ]]; then
        USE_LINK=true
      fi
    done
elif [ "$COMMAND" == "install" ]; then
    if [ -z "$2" ]; then
        echo "❌ Error: Please specify target path for 'install' command."
        exit 1
    fi
    TARGET_DIR="$2"
    # Check if $3 is a language or a flag
    if [[ "${3:-}" == --* ]] || [[ "${3:-}" == -* ]]; then
      LANG="cn"
    else
      LANG="${3:-cn}"
    fi
    # Check for --link flag in remaining args
    for arg in "${@:3}"; do
      if [[ "$arg" == "--link" ]] || [[ "$arg" == "-l" ]]; then
        USE_LINK=true
      fi
    done
else
    echo "❌ Unknown command: $COMMAND"
    show_help
    exit 1
fi

# Execution Logic
echo "🚀 Initializing Spec-AGENTS v3..."
echo "   📂 Source: $REPO_ROOT"
echo "   🎯 Target: $TARGET_DIR"

if [ ! -d "$TARGET_DIR" ]; then
  echo "   ⚠️  Target directory does not exist. Creating..."
  mkdir -p "$TARGET_DIR"
fi

TARGET_DIR_ABS="$(cd "$TARGET_DIR" && pwd)"
if [ "$TARGET_DIR_ABS" = "$REPO_ROOT" ]; then
  echo "❌ Error: Refusing to install into the Spec-AGENTS source repository itself."
  echo "   Please run 'spec-agents init' inside your project directory, not inside $REPO_ROOT"
  exit 1
fi

# Interactive mode: ask user if not specified via flag
if [ "$USE_LINK" == false ] && [ -t 0 ]; then
  echo ""
  echo "📋 Select installation mode:"
  echo "   [1] Copy files (default) - Independent, can customize locally"
  echo "   [2] Symbolic link - Auto-sync with updates, saves space"
  echo ""
  read -p "   Choice (1/2): " choice
  if [ "$choice" == "2" ]; then
    USE_LINK=true
  fi
fi

# 1. Install Modules
if [ "$USE_LINK" == true ]; then
  echo "   🔗 Linking intelligent modules (symlink mode)..."
else
  echo "   📦 Copying intelligent modules..."
fi

mkdir -p "$TARGET_DIR/.phrase/archive"

install_phrase_dir() {
  local dir_name="$1"
  local source_dir="$REPO_ROOT/.phrase/$dir_name"
  local target_dir="$TARGET_DIR/.phrase/$dir_name"

  [ -d "$source_dir" ] || return 0

  mkdir -p "$target_dir"
  for item in "$source_dir"/*; do
    if [ -e "$item" ]; then
      local basename_item
      basename_item=$(basename "$item")
      if [ "$USE_LINK" == true ]; then
        ln -sf "$item" "$target_dir/$basename_item"
      else
        cp -R "$item" "$target_dir/"
      fi
    fi
  done
}

install_phrase_dir "modules"
install_phrase_dir "docs"
install_phrase_dir "templates"
install_phrase_dir "commands"
install_phrase_dir "adr"
install_phrase_dir "protocol"
install_phrase_dir "runbooks"

install_phrase_file() {
  local file_name="$1"
  local source_file="$REPO_ROOT/.phrase/$file_name"
  local target_file="$TARGET_DIR/.phrase/$file_name"

  [ -f "$source_file" ] || return 0

  if [ "$USE_LINK" == true ]; then
    ln -sf "$source_file" "$target_file"
  else
    cp "$source_file" "$target_file"
  fi
}

install_phrase_file "decision.md"
install_phrase_file "roadmap.md"
install_phrase_file "current.md"
install_phrase_file "evidence.md"

# 3. Install Claude Code commands (.claude/commands/)
if [ -d "$REPO_ROOT/.phrase/commands" ]; then
  mkdir -p "$TARGET_DIR/.claude/commands"
  if [ "$USE_LINK" == true ]; then
    echo "   🔗 Linking Claude commands (symlink mode)..."
    for item in "$REPO_ROOT/.phrase/commands/"*; do
      if [ -e "$item" ]; then
        basename_item=$(basename "$item")
        ln -sf "$item" "$TARGET_DIR/.claude/commands/$basename_item"
      fi
    done
  else
    echo "   📋 Installing Claude commands..."
    cp "$REPO_ROOT/.phrase/commands/"* "$TARGET_DIR/.claude/commands/"
  fi
fi

# 2. Install Core Protocol
if [ "$USE_LINK" == true ]; then
  echo "   🔗 Linking AGENTS.md (symlink mode)..."
else
  echo "   📄 Copying AGENTS.md..."
fi

if [ "$LANG" == "en" ]; then
  if [ "$USE_LINK" == true ]; then
    ln -sf "$REPO_ROOT/AGENTS_en.md" "$TARGET_DIR/AGENTS.md"
  else
    cp "$REPO_ROOT/AGENTS_en.md" "$TARGET_DIR/AGENTS.md"
  fi
  echo "   🌐 Language: English"
else
  if [ "$USE_LINK" == true ]; then
    ln -sf "$REPO_ROOT/AGENTS.md" "$TARGET_DIR/AGENTS.md"
  else
    cp "$REPO_ROOT/AGENTS.md" "$TARGET_DIR/AGENTS.md"
  fi
  echo "   🌐 Language: Chinese"
fi

if [ "$USE_LINK" == true ]; then
  echo ""
  echo "   ⚠️  Note: Using symbolic links. Changes to source files will affect this project."
  echo "      Source: $REPO_ROOT"
fi

echo ""
echo "✨ Done! Spec-AGENTS is ready."
echo "   Installed:"
echo "   - $TARGET_DIR/AGENTS.md"
echo "   - $TARGET_DIR/.phrase/modules"
echo "   - $TARGET_DIR/.phrase/docs"
echo "   - $TARGET_DIR/.phrase/templates"
echo "   - $TARGET_DIR/.phrase/commands"
echo "   - $TARGET_DIR/.phrase/decision.md"
echo "   - $TARGET_DIR/.phrase/roadmap.md"
echo "   - $TARGET_DIR/.phrase/current.md"
echo "   - $TARGET_DIR/.phrase/evidence.md"
echo "   - $TARGET_DIR/.phrase/archive"
if [ -d "$TARGET_DIR/.claude/commands" ]; then
  echo "   - $TARGET_DIR/.claude/commands"
fi
echo "   To start, simply tell your AI Agent: 'Read AGENTS.md'"
