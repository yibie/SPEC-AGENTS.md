#!/bin/bash
set -e

# Spec-AGENTS CLI
# 自动定位仓库根目录（即脚本所在目录的上一级）
# 兼容 macOS/Linux 的 readlink 问题

VERSION="4.0.4"

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$( cd -P "$( dirname "$SOURCE" )/.." && pwd )"

# CLI argument parsing
COMMAND="${1:-}"
TARGET_DIR="${2:-.}"
LANG="${3:-cn}"
USE_LINK=false
HAS_LEGACY=false

for arg in "$@"; do
  case "$arg" in
    --link|-l)
      USE_LINK=true
      ;;
    --legacy)
      echo "❌ Error: --legacy is no longer an installation mode."
      echo "   Install the modern entry points, then read UPGRADE.md."
      exit 1
      ;;
  esac
done

show_help() {
  echo "🤖 Spec-AGENTS CLI v$VERSION"
  echo ""
  echo "Usage:"
  echo "  spec-agents init [lang] [--link|-l]           Initialize current directory"
  echo "  spec-agents install <path> [lang] [--link|-l] Install modern layout"
  echo ""
  echo "Arguments:"
  echo "  lang: cn (default) | en"
  echo "  --link, -l: Use symbolic links instead of copying files"
  echo ""
  echo "For an existing v2/v3 project, install the modern entry points and read"
  echo "UPGRADE.md. The upgrade review is performed by an Agent with user confirmation."
}

if [ -z "$COMMAND" ] || [ "$COMMAND" == "help" ] || [ "$COMMAND" == "--help" ] || [ "$COMMAND" == "-h" ]; then
  show_help
  exit 0
fi

if [ "$COMMAND" == "init" ]; then
  TARGET_DIR="."
  if [[ "${2:-}" == --* ]] || [[ "${2:-}" == -* ]]; then
    LANG="cn"
  else
    LANG="${2:-cn}"
  fi
elif [ "$COMMAND" == "install" ]; then
  if [ -z "${2:-}" ]; then
    echo "❌ Error: Please specify target path for 'install' command."
    exit 1
  fi
  TARGET_DIR="$2"
  if [[ "${3:-}" == --* ]] || [[ "${3:-}" == -* ]]; then
    LANG="cn"
  else
    LANG="${3:-cn}"
  fi
elif [ "$COMMAND" == "upgrade" ]; then
  echo "❌ Error: Upgrade is Prompt-driven, not an installer operation."
  echo "   Install the modern entry points, then read UPGRADE.md."
  exit 1
else
  echo "❌ Unknown command: $COMMAND"
  show_help
  exit 1
fi

echo "🚀 Initializing Spec-AGENTS v4..."
echo "   📂 Source: $REPO_ROOT"
echo "   🎯 Target: $TARGET_DIR"

if [ ! -d "$TARGET_DIR" ]; then
  echo "   ⚠️  Target directory does not exist. Creating..."
  mkdir -p "$TARGET_DIR"
fi

TARGET_DIR_ABS="$(cd "$TARGET_DIR" && pwd)"
if [ "$TARGET_DIR_ABS" = "$REPO_ROOT" ]; then
  echo "❌ Error: Refusing to install into the Spec-AGENTS source repository itself."
  echo "   Please provide a separate project directory, not $REPO_ROOT"
  exit 1
fi

if [ -d "$TARGET_DIR/.phrase" ]; then
  HAS_LEGACY=true
else
  for legacy_pattern in spec_* plan_* task_* change_* issue_*; do
    if [ -e "$TARGET_DIR/$legacy_pattern" ]; then
      HAS_LEGACY=true
      break
    fi
  done
fi

# Interactive mode: ask only when copy/link was not specified.
if [ "$USE_LINK" == false ] && [ -t 0 ]; then
  echo ""
  echo "📋 Select installation mode:"
  echo "   [1] Copy files (default) - Independent, can customize locally"
  echo "   [2] Symbolic link - Auto-sync with updates, saves space"
  echo ""
  read -p "   Choice (1/2): " choice
  if [ "$choice" == "2" ]; then
    USE_LINK=true
  fi
fi

install_file() {
  local source_file="$1"
  local target_file="$2"

  [ -f "$source_file" ] || return 0
  if [ -e "$target_file" ] || [ -L "$target_file" ]; then
    echo "   ⚠️  Keeping existing file: $target_file"
    return 0
  fi
  mkdir -p "$(dirname "$target_file")"

  if [ "$USE_LINK" == true ]; then
    ln -s "$source_file" "$target_file"
  else
    cp "$source_file" "$target_file"
  fi
}

install_dir_contents() {
  local source_dir="$1"
  local target_dir="$2"

  [ -d "$source_dir" ] || return 0
  mkdir -p "$target_dir"
  for item in "$source_dir"/*; do
    if [ -e "$item" ]; then
      local basename_item
      local target_item
      basename_item=$(basename "$item")
      target_item="$target_dir/$basename_item"
      if [ -e "$target_item" ] || [ -L "$target_item" ]; then
        continue
      fi
      if [ "$USE_LINK" == true ]; then
        ln -s "$item" "$target_item"
      else
        cp -R "$item" "$target_dir/"
      fi
    fi
  done
}

install_agent() {
  if [ "$LANG" == "en" ]; then
    install_file "$REPO_ROOT/AGENTS_en.md" "$TARGET_DIR/AGENTS.md"
    echo "   🌐 Language: English"
  else
    install_file "$REPO_ROOT/AGENTS.md" "$TARGET_DIR/AGENTS.md"
    echo "   🌐 Language: Chinese"
  fi
}

echo "   📦 Installing modern root layout..."
install_agent
for file_name in CONTEXT.md ROADMAP.md STATUS.md EVIDENCE.md UPGRADE.md; do
  install_file "$REPO_ROOT/$file_name" "$TARGET_DIR/$file_name"
done
install_dir_contents "$REPO_ROOT/docs" "$TARGET_DIR/docs"
install_dir_contents "$REPO_ROOT/archive" "$TARGET_DIR/archive"
install_dir_contents "$REPO_ROOT/skills" "$TARGET_DIR/skills"

if [ "$HAS_LEGACY" == true ]; then
  echo ""
  echo "   ⚠️  Existing legacy SPEC material detected."
  echo "      Read $TARGET_DIR/UPGRADE.md before ordinary work."
fi

if [ "$USE_LINK" == true ]; then
  echo ""
  echo "   ⚠️  Note: Using symbolic links. Changes to source files will affect this project."
  echo "      Source: $REPO_ROOT"
fi

echo ""
echo "✨ Done! Spec-AGENTS is ready."
echo "   Installed:"
echo "   - $TARGET_DIR/AGENTS.md"
echo "   - $TARGET_DIR/CONTEXT.md"
echo "   - $TARGET_DIR/ROADMAP.md"
echo "   - $TARGET_DIR/STATUS.md"
echo "   - $TARGET_DIR/EVIDENCE.md"
echo "   - $TARGET_DIR/UPGRADE.md"
echo "   - $TARGET_DIR/docs"
echo "   - $TARGET_DIR/archive"
echo "   - $TARGET_DIR/skills/{plan,capture,arrange,do,check,learn}"
echo "   To start, simply tell your AI Agent: 'Read AGENTS.md'"
